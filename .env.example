# 复制为 .env 后按需修改。切勿把真实密钥提交到仓库。

# ----- 应用 -----
APP_NAME=ai-cs-platform
APP_ENV=local
DEBUG=true

# ----- PostgreSQL（必须使用 postgresql+asyncpg:// 前缀）-----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_cs_platform

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- 日志 -----
LOG_LEVEL=INFO

# ----- LLM -----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
# 轮级 LLM 时间预算（秒，0=关闭）：一轮内所有 LLM 调用共享，耗尽走降级（post-stage-20）
TURN_LLM_BUDGET_SECONDS=40

# ----- Stage 17 LLM 成本控制（可独立开关，均默认关闭=零回归）-----
# 模型分级路由：留空则回落 CHAT_MODEL。classify（二判/槽位/短润色）走 fast，
# generate（RAG 生成/复杂润色）走 smart
CHAT_MODEL_FAST=
CHAT_MODEL_SMART=
# 租户 token 预算与熔断：超日预算后 LLM 增强层全部降级模板（与无 Key 同路径）。
# DAILY_TOKENS=0 表示不限
LLM_BUDGET_ENABLED=false
LLM_BUDGET_DAILY_TOKENS=0
# 语义缓存：可缓存轮次（FAQ/RAG/闲聊）按查询 embedding 相似度直答（严格租户隔离+TTL）
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_PER_TENANT=200

# ----- Stage 18 A/B 实验框架 -----
# 实验配置文件路径（JSON）；留空=无实验运行（主链路零回归）。
# 变体只能覆盖白名单内已有配置项（RAG_MIN_SCORE/FAQ_HIT_THRESHOLD/RAG_RECALL_TOP_K/RERANKER_PROVIDER）。
# CLI：uv run python scripts/experiments.py list|bucket|sample
EXPERIMENTS_CONFIG_PATH=

# ----- Embedding（Stage 06 RAG）-----
# openai=OpenAI 兼容接口；hash=本地确定性伪向量（仅开发/测试，禁止生产）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
EMBEDDING_TIMEOUT=15

# ----- 知识库 / 向量检索（Stage 06）-----
KB_ENABLED=true
KB_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_TIMEOUT=5
# 阈值按真实语义 embedding 校准；EMBEDDING_PROVIDER=hash 时建议降为 0.6 / 0.25
FAQ_HIT_THRESHOLD=0.88
RAG_MIN_SCORE=0.60
RAG_TOP_K=5
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
# 知识库管理 API 临时保护 token（Stage 08 前过渡方案），为空则不校验
KB_ADMIN_TOKEN=

# ----- 意图分类器（Stage 04-02 SetFit）-----
# rule=纯规则；hybrid=规则控制层+SetFit 语义层（需先训练：uv run python scripts/train_setfit_intent.py）
INTENT_CLASSIFIER=rule
SETFIT_MODEL_PATH=models/intent_setfit_v1
INTENT_CONFIDENCE_THRESHOLD=0.40
INTENT_CONFIDENCE_THRESHOLD_WRITE=0.60

# ----- 文档解析（Stage 06-02）-----
# MinerU HTTP 服务地址（图文混排/扫描 PDF 深度解析），为空则跳过该解析级
MINERU_API_URL=
MINERU_TIMEOUT=120
# Docling 本地解析级（首次运行下载版面模型；未安装/false 时自动跳过）
DOCLING_ENABLED=true
# 碎片块合并阈值
KB_MIN_CHUNK_CHARS=30

# ----- LLM 增强开关（Stage 04-01，OPENAI_API_KEY 为空时自动失效）-----
LLM_REPLY_ENABLED=true
LLM_INTENT_SECOND_OPINION=true
LLM_SLOT_FALLBACK=true
LLM_HISTORY_MAX_TURNS=4

# ----- 工具层与确认门（Stage 05）-----
TOOL_PROVIDER=mock
TOOL_TIMEOUT=10
SKILL_LOADER_STRICT=false
TASK_STACK_MAX=2

# ----- 鉴权与多租户加固（Stage 08）-----
# 生产必须 true：tenant_id 从 API Key 凭证解析（密钥用 scripts/manage_api_keys.py 创建）
AUTH_ENABLED=false
AUTH_CACHE_TTL=300
RATE_LIMIT_TENANT_PER_MINUTE=600
RATE_LIMIT_SESSION_PER_MINUTE=30
IDEMPOTENCY_TTL=600
MAX_REQUEST_BODY_BYTES=1048576
# CORS 允许来源（逗号分隔，空=不启用）
CORS_ORIGINS=

# ----- 多任务治理与记忆（Stage 10）-----
# 任务时效（分钟）：超时未推进的任务加载时丢弃
TASK_TTL_MINUTES=30
# 同一任务追问上限：超过后放弃并建议转人工
TASK_MAX_ASKS=3
# 记忆：local=自研（短期窗口+LLM 摘要+长期事实）；mem0=接入 mem0（不可用降级 local）；off=关闭
MEMORY_PROVIDER=local
MEMORY_SHORT_TERM_TURNS=8
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_LONG_TERM_MAX=5
# 摘要滚动步长：距上次摘要新增消息数达到该值才再次续写（post-stage-20，防每轮触发 LLM）
MEMORY_SUMMARY_STEP=6
# 后台记忆任务并发上限（post-stage-20，防与请求争抢连接池/LLM 额度）
MEMORY_TASK_CONCURRENCY=3

# ----- 检索管道 v2（Stage 06-04）-----
RAG_RECALL_TOP_K=20
# 重排器：off=RRF 序；local=本地 CrossEncoder（生产建议开启，首次运行下载模型）
RERANKER_PROVIDER=off
RERANK_MODEL=BAAI/bge-reranker-base
RAG_AMBIGUITY_DELTA=0.05
RAG_SECTION_CONTEXT_CHARS=1200
# 含糊查询 LLM 改写（post-stage-20 WeKnora 对齐：先重写再检索；无 Key 自动失效）
RAG_QUERY_REWRITE_ENABLED=true

# ----- Stage 21 智能澄清 -----
# UNKNOWN 轮次用 LLM 生成针对性澄清问句（top_k 候选+近期对话）；无 Key 降级固定模板
CLARIFY_LLM_ENABLED=true
CLARIFY_MIN_CANDIDATE_SCORE=0.15

# ----- Stage 24 部署编排（docker-compose.prod.yml / deploy/scheduler.py）-----
# 生产 compose 用它拼 DATABASE_URL 与初始化 PG（缺失拒绝启动）
# POSTGRES_PASSWORD=
# cron 最终失败告警 webhook（企微/钉钉/Slack；留空只记日志）
# ALERT_WEBHOOK_URL=
# 定时任务间隔（秒，0=停用）：会话生命周期 / 知识库定时生效 / 质量视图刷新
# CRON_IDLE_SESSIONS_INTERVAL=600
# CRON_KB_SCHEDULE_INTERVAL=600
# CRON_QUALITY_VIEWS_INTERVAL=3600
# CRON_CASE_SLA_INTERVAL=600

# ----- Stage 25 监控（--profile monitoring）-----
# Grafana 管理员密码（启用 monitoring profile 时必填）
# GRAFANA_ADMIN_PASSWORD=

# ----- Stage 23 对话方向纠偏 -----
# 中置信软确认阈值：SETFIT/LLM 来源低于该置信的新开任务，追问前复述意图
INTENT_SOFT_CONFIRM_THRESHOLD=0.60

# ----- Stage 26 意图决策加固（阈值均为待真实流量标定的保守默认）-----
# SetFit top1-top2 最小分差：低于此值视为模糊难例（二判/软确认接住，绝不改选 top2）
INTENT_MIN_MARGIN=0.10
# 任务进行态（补槽/确认门）新意图挂起切换所需最低置信；显式切换信号走普通阈值
INTENT_SWITCH_THRESHOLD_COLLECTING=0.78
INTENT_SWITCH_THRESHOLD_CONFIRMING=0.85
# 写意图软确认线（单列高于采纳线，修复写意图永不软确认的死区）
INTENT_SOFT_CONFIRM_THRESHOLD_WRITE=0.75

# ----- 示例向量交叉验证（功能已实现，默认关闭；启用时机见 docs/intent/README.md）-----
# 启用前先建索引：uv run python scripts/build_intent_example_index.py
INTENT_EXAMPLE_KNN_ENABLED=false
INTENT_EXAMPLE_KNN_TOPK=5
INTENT_EXAMPLE_KNN_MIN_SIM=0.65
# 低置信闲聊救援线（家常「今天真热」免二判；只救 CHITCHAT.*，业务意图永不救援）
INTENT_KNN_CHITCHAT_MIN_SIM=0.70
INTENT_EXAMPLE_INDEX_DIR=models/intent_example_index

# ----- Stage 30 对话模式门（默认关闭=零回归；启用步骤见 docs/intent/mode_gate_training.md）-----
# 启用前先训练：uv run python scripts/train_mode_gate.py（需 SetFit 产物在位）
# v1 只接管高置信纯闲聊（免 LLM 二判直接回复+任务保持续办提示），其余模式影子观察
MODE_GATE_ENABLED=false
MODE_GATE_DIR=models/mode_gate_v1
# SOCIAL 直通线/分差线/任务中加严线（冷启动基线，按业务误吞率标定）
MODE_GATE_SOCIAL_MIN_SCORE=0.88
MODE_GATE_SOCIAL_MIN_MARGIN=0.20
MODE_GATE_SOCIAL_MIN_SCORE_ACTIVE=0.92
# OOS 能力边界回复子开关（合成 OOS 数据未经真实验证，影子先行）
MODE_GATE_OOS_REPLY_ENABLED=false

# ----- Stage 31 主动服务（默认双关=零回归；抑制矩阵见 stage-31 需求第 4 节）-----
# ENABLED=计算+落决策日志（影子）；APPLY=真实把活动提示追加进回复
PROACTIVE_ENABLED=false
PROACTIVE_APPLY=false
# 活动池 JSON（示例 configs/campaigns.example.json，复制为 campaigns.json 后编辑）
CAMPAIGN_CONFIG_PATH=configs/campaigns.json
PROACTIVE_SESSION_MAX=1
PROACTIVE_REJECT_COOLDOWN_HOURS=48
# Stage 33 会员注册建议（受总开关管控；查会员状态确认未注册才建议，客户级上限）
PROACTIVE_ONBOARDING_ENABLED=true
PROACTIVE_ONBOARDING_MAX=2
# ----- Stage 41 会话主动引导与建议闭环（受 PROACTIVE_ENABLED 总开关双关）-----
# 开场引导：会话创建即发轻量欢迎（同客户 24h 一次，opt-out/at_risk/Redis 故障不发）
PROACTIVE_WELCOME_ENABLED=false
# 开场/服务延伸配置（示例 configs/*.example.json，复制去掉 .example 后编辑）
WELCOME_CONFIG_PATH=configs/welcome.json
FOLLOWUP_CONFIG_PATH=configs/followups.json

# ----- Stage 40 行为准则层（借鉴 Parlant，默认关；只注入润色/RAG/澄清等 LLM 路径）-----
GUIDELINES_ENABLED=false
# 准则表（示例 configs/guidelines.example.json，复制为 guidelines.json 后编辑）
GUIDELINES_CONFIG_PATH=configs/guidelines.json
GUIDELINES_MAX_INJECT=3

# ----- Stage 36 事件驱动主动客服（POST /api/events，默认关）-----
EVENTS_ENABLED=false
# 静默时间（如 22-8 跨零点；空=不启用）
EVENTS_QUIET_HOURS=

# ----- Stage 35 身份核验分级（工具最低等级声明在 app/chat/tools/catalog.py）-----
# 开发默认 2=沙盒互信零回归；生产下调到 0/1 后 IAL2 工具（改地址）未达标转人工核实
IDENTITY_DEFAULT_LEVEL=2
IDENTITY_LEVEL_AUTHENTICATED=1

# ----- Stage 34 Case 工单与 SLA（超时升级走 cron case_sla_check）-----
CASE_SLA_HOURS_HIGH=4
CASE_SLA_HOURS_NORMAL=24
CASE_SLA_HOURS_LOW=72
# 补偿政策表（Service Recovery；示例 configs/compensation_policies.example.json）
COMPENSATION_POLICY_PATH=configs/compensation_policies.json

# ----- Stage 27 Meta-classifier 影子模式（只观察不决策，产物缺失自动停用）-----
META_SHADOW_ENABLED=true
# champion=按训练产物 metrics.json 冠军；或显式 lr/lgbm/xgb
META_SHADOW_MODEL=champion
META_SHADOW_DIR=models/meta_classifier_v1

# ----- Stage 22 只读诊断 agent（默认关闭=零回归，真实 LLM 联调后开启）-----
# 解释性查询（"为什么还没到"）的多步只读调查：query_* 白名单+结构性终止+数字事实校验
DIAGNOSE_AGENT_ENABLED=false
DIAGNOSE_MAX_STEPS=3

# ----- MCP 业务工具服务（Stage 11）-----
# TOOL_PROVIDER=mcp 时启用；服务启动：uv run python scripts/run_mcp_server.py
MCP_SERVER_URL=http://localhost:8400/mcp
MCP_TIMEOUT=10

# ----- 人工接管（Stage 07）-----
# 连续 N 轮 UNKNOWN 兜底后自动登记转人工工单
HANDOFF_UNKNOWN_STREAK=2

# ----- Langfuse 链路追踪（Stage 12，可选）-----
# 双 Key 齐全才启用；未配置/服务不可达自动降级，不影响主链路。生产建议自托管
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Stage 13 生产加固 -----
# MCP 调用失败降级：fail=如实报上游不可用（生产语义）；mock=假数据兜底（仅开发联调）
TOOL_MCP_FALLBACK=fail
# 多进程部署时设置该目录启用 Prometheus 多 worker 聚合（如 /var/run/prom-mp）
# PROMETHEUS_MULTIPROC_DIR=

# ----- 内容安全护栏（Stage 14）-----
GUARDRAIL_ENABLED=true
# 重度违禁连击 N 次 → 建工单（reason=ABUSE）并静默会话
GUARDRAIL_ABUSE_STREAK=2
# 同文本连发 N 次 → 拦截提示换说法
GUARDRAIL_REPEAT_LIMIT=3

# ----- 体验闭环（Stage 15）-----
# 空闲会话自动关闭（小时，定时任务 scripts/close_idle_sessions.py）
SESSION_IDLE_CLOSE_HOURS=24
# 会话关闭时发送满意度询问
CSAT_ON_CLOSE=true
# 已认领工单超时（小时）→ CLOSED + 会话归还
TICKET_STALE_HOURS=24

# ----- 多语言地基（Stage 19）-----
# 默认/源语言（面向用户文案与提示词的回退语言，zh 逐字对齐现有中文）
LOCALE_DEFAULT=zh
# 支持的语言（逗号分隔）；请求 locale 不在此列表时回退默认
SUPPORTED_LOCALES=zh,en
