# 复制为 .env 后按需修改。切勿把真实密钥提交到仓库。

# ----- 应用 -----
APP_NAME=ai-cs-platform
APP_ENV=local
DEBUG=true

# ----- PostgreSQL（必须使用 postgresql+asyncpg:// 前缀）-----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_cs_platform

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- 日志 -----
LOG_LEVEL=INFO

# ----- LLM -----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
# 轮级 LLM 时间预算（秒，0=关闭）：一轮内所有 LLM 调用共享，耗尽走降级（post-stage-20）
TURN_LLM_BUDGET_SECONDS=40

# ----- Stage 17 LLM 成本控制（可独立开关，均默认关闭=零回归）-----
# 模型分级路由：留空则回落 CHAT_MODEL。classify（二判/槽位/短润色）走 fast，
# generate（RAG 生成/复杂润色）走 smart
CHAT_MODEL_FAST=
CHAT_MODEL_SMART=
# 租户 token 预算与熔断：超日预算后 LLM 增强层全部降级模板（与无 Key 同路径）。
# DAILY_TOKENS=0 表示不限
LLM_BUDGET_ENABLED=false
LLM_BUDGET_DAILY_TOKENS=0
# 语义缓存：可缓存轮次（FAQ/RAG/闲聊）按查询 embedding 相似度直答（严格租户隔离+TTL）
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_PER_TENANT=200

# ----- Stage 18 A/B 实验框架 -----
# 实验配置文件路径（JSON）；留空=无实验运行（主链路零回归）。
# 变体只能覆盖白名单内已有配置项（RAG_MIN_SCORE/FAQ_HIT_THRESHOLD/RAG_RECALL_TOP_K/RERANKER_PROVIDER）。
# CLI：uv run python scripts/experiments.py list|bucket|sample
EXPERIMENTS_CONFIG_PATH=

# ----- Embedding（Stage 06 RAG）-----
# openai=OpenAI 兼容接口；hash=本地确定性伪向量（仅开发/测试，禁止生产）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
EMBEDDING_TIMEOUT=15

# ----- 知识库 / 向量检索（Stage 06）-----
KB_ENABLED=true
KB_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_TIMEOUT=5
# 阈值按真实语义 embedding 校准；EMBEDDING_PROVIDER=hash 时建议降为 0.6 / 0.25
FAQ_HIT_THRESHOLD=0.88
RAG_MIN_SCORE=0.60
RAG_TOP_K=5
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
# 知识库管理 API 临时保护 token（Stage 08 前过渡方案），为空则不校验
KB_ADMIN_TOKEN=

# ----- 意图分类器（Stage 04-02 SetFit）-----
# rule=纯规则；hybrid=规则控制层+SetFit 语义层（需先训练：uv run python scripts/train_setfit_intent.py）
INTENT_CLASSIFIER=rule
SETFIT_MODEL_PATH=models/intent_setfit_v1
INTENT_CONFIDENCE_THRESHOLD=0.40
INTENT_CONFIDENCE_THRESHOLD_WRITE=0.60

# ----- 文档解析（Stage 06-02）-----
# MinerU HTTP 服务地址（图文混排/扫描 PDF 深度解析），为空则跳过该解析级
MINERU_API_URL=
MINERU_TIMEOUT=120
# Docling 本地解析级（首次运行下载版面模型；未安装/false 时自动跳过）
DOCLING_ENABLED=true
# 碎片块合并阈值
KB_MIN_CHUNK_CHARS=30

# ----- LLM 增强开关（Stage 04-01，OPENAI_API_KEY 为空时自动失效）-----
LLM_REPLY_ENABLED=true
LLM_INTENT_SECOND_OPINION=true
LLM_SLOT_FALLBACK=true
LLM_HISTORY_MAX_TURNS=4

# ----- 工具层与确认门（Stage 05）-----
TOOL_PROVIDER=mock
TOOL_TIMEOUT=10
SKILL_LOADER_STRICT=false
TASK_STACK_MAX=2

# ----- 鉴权与多租户加固（Stage 08）-----
# 生产必须 true：tenant_id 从 API Key 凭证解析（密钥用 scripts/manage_api_keys.py 创建）
AUTH_ENABLED=false
AUTH_CACHE_TTL=300
RATE_LIMIT_TENANT_PER_MINUTE=600
RATE_LIMIT_SESSION_PER_MINUTE=30
IDEMPOTENCY_TTL=600
MAX_REQUEST_BODY_BYTES=1048576
# CORS 允许来源（逗号分隔，空=不启用）
CORS_ORIGINS=

# ----- 多任务治理与记忆（Stage 10）-----
# 任务时效（分钟）：超时未推进的任务加载时丢弃
TASK_TTL_MINUTES=30
# 同一任务追问上限：超过后放弃并建议转人工
TASK_MAX_ASKS=3
# 记忆：local=自研（短期窗口+LLM 摘要+长期事实）；mem0=接入 mem0（不可用降级 local）；off=关闭
MEMORY_PROVIDER=local
MEMORY_SHORT_TERM_TURNS=8
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_LONG_TERM_MAX=5
# 摘要滚动步长：距上次摘要新增消息数达到该值才再次续写（post-stage-20，防每轮触发 LLM）
MEMORY_SUMMARY_STEP=6
# 后台记忆任务并发上限（post-stage-20，防与请求争抢连接池/LLM 额度）
MEMORY_TASK_CONCURRENCY=3

# ----- 检索管道 v2（Stage 06-04）-----
RAG_RECALL_TOP_K=20
# 重排器：off=RRF 序；local=本地 CrossEncoder（生产建议开启，首次运行下载模型）
RERANKER_PROVIDER=off
RERANK_MODEL=BAAI/bge-reranker-base
RAG_AMBIGUITY_DELTA=0.05
RAG_SECTION_CONTEXT_CHARS=1200
# 含糊查询 LLM 改写（post-stage-20 WeKnora 对齐：先重写再检索；无 Key 自动失效）
RAG_QUERY_REWRITE_ENABLED=true

# ----- MCP 业务工具服务（Stage 11）-----
# TOOL_PROVIDER=mcp 时启用；服务启动：uv run python scripts/run_mcp_server.py
MCP_SERVER_URL=http://localhost:8400/mcp
MCP_TIMEOUT=10

# ----- 人工接管（Stage 07）-----
# 连续 N 轮 UNKNOWN 兜底后自动登记转人工工单
HANDOFF_UNKNOWN_STREAK=2

# ----- Langfuse 链路追踪（Stage 12，可选）-----
# 双 Key 齐全才启用；未配置/服务不可达自动降级，不影响主链路。生产建议自托管
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Stage 13 生产加固 -----
# MCP 调用失败降级：fail=如实报上游不可用（生产语义）；mock=假数据兜底（仅开发联调）
TOOL_MCP_FALLBACK=fail
# 多进程部署时设置该目录启用 Prometheus 多 worker 聚合（如 /var/run/prom-mp）
# PROMETHEUS_MULTIPROC_DIR=

# ----- 内容安全护栏（Stage 14）-----
GUARDRAIL_ENABLED=true
# 重度违禁连击 N 次 → 建工单（reason=ABUSE）并静默会话
GUARDRAIL_ABUSE_STREAK=2
# 同文本连发 N 次 → 拦截提示换说法
GUARDRAIL_REPEAT_LIMIT=3

# ----- 体验闭环（Stage 15）-----
# 空闲会话自动关闭（小时，定时任务 scripts/close_idle_sessions.py）
SESSION_IDLE_CLOSE_HOURS=24
# 会话关闭时发送满意度询问
CSAT_ON_CLOSE=true
# 已认领工单超时（小时）→ CLOSED + 会话归还
TICKET_STALE_HOURS=24

# ----- 多语言地基（Stage 19）-----
# 默认/源语言（面向用户文案与提示词的回退语言，zh 逐字对齐现有中文）
LOCALE_DEFAULT=zh
# 支持的语言（逗号分隔）；请求 locale 不在此列表时回退默认
SUPPORTED_LOCALES=zh,en
